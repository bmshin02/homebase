# Copy to .env.local and fill in. Never commit real keys.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; everything else stays on the server.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API, server routes only (space estimator, recommendations)
ANTHROPIC_API_KEY=

# Stripe Connect, TEST MODE keys only (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps (only if we pick Mapbox; Leaflet + OpenStreetMap needs no key)
NEXT_PUBLIC_MAPBOX_TOKEN=
